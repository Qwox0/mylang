libc :: #import "libc";

// TODO: add real context.
mut static ctx := struct {
    alloc: mem.Allocator;
}.{
    alloc = mem.c_allocator,
};

panic :: (msg: []u8) -> never {
    libc.fprintf(libc.stderr, "PANIC: %.*s\n".ptr, msg.len, msg.ptr);
    libc.abort();
}

assert :: (cond: bool, msg := "") -> if !cond do panic(str.concat("Assertion failed! ", msg));

malloc0 :: (size: libc.c_size_t) -> {
    ptr := libc.malloc(size) orelse return null;
    libc.memset(ptr, 0, size);
    ptr
}

open_file :: (pathname: []u8, mode: []u8) -> *libc.FILE {
    // currently all string slices are 0 terminated, so this should be fine.
    libc.fopen(pathname.ptr, mode.ptr) orelse panic("No such file or directory")
}

get_file_size :: (file: *libc.FILE) -> u64 {
    cur_pos := libc.ftell(file);

    libc.fseek(file, 0, libc.SEEK_END);
    size := libc.ftell(file);
    if size < 0 do panic("Cannot get file size");

    libc.fseek(file, cur_pos, libc.SEEK_SET);
    size.as(u64)
}

/// The `ptr` on the returned slice must be `free`d by the caller.
read_file_as_string_slice :: (pathname: []u8) -> []u8 {
    file := open_file(pathname, "rb");
    defer libc.fclose(file);

    length := get_file_size(file);
    s := str.malloc_str(length);
    libc.fread(s.ptr, 1, length, file);
    s
}

read_file :: (file: *libc.FILE, buf: []mut u8) -> {
    length := get_file_size(file);
    if buf.len < length then panic("buffer too small");
    read := libc.fread(buf.ptr, 1, length, file);
    if read < length then panic("read failed");
    assert(read == length);
    buf[..length]
}

print :: (str: []u8) -> void {
    for idx in 0..str.len {
        libc.putchar(str[idx]); // handle output == EOF?
    }
}

println :: (str: []u8) -> void {
    print(str);
    libc.putchar('\n'); // handle output == EOF?
}

escaped_print :: (str: []u8, stream := libc.stdout) -> {
    for char in str {
        if char == 0               libc.fputs("\\0".ptr, stream)
        else if char == '\t'       libc.fputs("\\t".ptr, stream)
        else if char == '\n'       libc.fputs("\\n".ptr, stream)
        else if char == '\r'       libc.fputs("\\r".ptr, stream)
        else if char == '\\'       libc.fputs("\\\\".ptr, stream)
        else if char == '\''       libc.fputs("\\'".ptr, stream)
        else if char == '\"'       libc.fputs("\\\"".ptr, stream)
        else if libc.isprint(char) != 0 libc.fputc(char, stream)
        else                       libc.fprintf(stream, "\\x%02x".ptr, char);
    }
}

escaped_println :: (str: []u8, stream := libc.stdout) -> {
    escaped_print(str, stream);
    libc.fputc('\n', stream);
}

fail_errno :: (thing: []u8) -> never {
    errno := libc.get_errno();
    libc.printf("%.*s failed. %s: %s\n".ptr, thing.len, thing.ptr, errno.strerrorname_np(), errno.strerror());
    libc.abort()
}

