libc :: #import "libc";

// TODO: add real context.
mut static ctx := struct {
    alloc: mem.Allocator;
}.{
    alloc = mem.c_allocator,
};

panic :: (msg: []u8) -> never {
    libc.fprintf(libc.stderr, "PANIC: %.*s\n".ptr, msg.len, msg.ptr);
    libc.abort();
}

assert :: (cond: bool, msg := "") -> if !cond do panic(str.concat("Assertion failed! ", msg));

malloc0 :: (size: libc.c_size_t) -> {
    ptr := libc.malloc(size) orelse return null;
    libc.memset(ptr, 0, size);
    ptr
}

print :: (str: []u8) -> void {
    for idx in 0..str.len {
        libc.putchar(str[idx]); // handle output == EOF?
    }
}

println :: (str: []u8) -> void {
    print(str);
    libc.putchar('\n'); // handle output == EOF?
}

escaped_print :: (str: []u8, stream := libc.stdout) -> {
    for char in str {
        if char == 0               libc.fputs("\\0".ptr, stream)
        else if char == '\t'       libc.fputs("\\t".ptr, stream)
        else if char == '\n'       libc.fputs("\\n".ptr, stream)
        else if char == '\r'       libc.fputs("\\r".ptr, stream)
        else if char == '\\'       libc.fputs("\\\\".ptr, stream)
        else if char == '\''       libc.fputs("\\'".ptr, stream)
        else if char == '\"'       libc.fputs("\\\"".ptr, stream)
        else if libc.isprint(char) != 0 libc.fputc(char, stream)
        else                       libc.fprintf(stream, "\\x%02x".ptr, char);
    }
}

escaped_println :: (str: []u8, stream := libc.stdout) -> {
    escaped_print(str, stream);
    libc.fputc('\n', stream);
}

fail_errno :: (thing: []u8) -> never {
    errno := libc.get_errno();
    libc.printf("%.*s failed. %s: %s\n".ptr, thing.len, thing.ptr, errno.strerrorname_np(), errno.strerror());
    libc.abort()
}

