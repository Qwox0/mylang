std :: #import "std";

u8_MAX  : u8  : 0xff;
u16_MAX : u16 : 0xffff;
u32_MAX : u32 : 0xffff_ffff;
u64_MAX : u64 : 0xffff_ffff_ffff_ffff;

i8_MAX  : i8  : 0x7f;
i16_MAX : i16 : 0x7fff;
i32_MAX : i32 : 0x7fff_ffff;
i64_MAX : i64 : 0x7fff_ffff_ffff_ffff;

i8_MIN  : i8  : !i8_MAX;
i16_MIN : i16 : !i16_MAX;
i32_MIN : i32 : !i32_MAX;
i64_MIN : i64 : !i64_MAX;

clz32 : (u32, is_zero_poison: bool) -> u32 : #intrinsic "llvm.ctlz.i32";
clz64 : (u64, is_zero_poison: bool) -> u64 : #intrinsic "llvm.ctlz.i64";

ceil_pow_of_2_u32 :: (mut x: $Int) -> if x <= 1 then 1 else 1 << (32 - clz32(x - 1, true));
ceil_pow_of_2_u64 :: (mut x: $Int) -> if x <= 1 then 1 else 1 << (64 - clz64(x - 1, true));

is_power_of_2 :: (x: $Uint) -> x != 0 && (x & (x - 1)) == 0;

is_multiple_of :: (lhs: $Int, rhs: Int) -> bool {
    if rhs == 0 then lhs == 0 else lhs % rhs == 0
}

max :: (a: uint, b: uint) -> if a > b then a else b;
max_u32 :: (a: u32, b: u32) -> if a > b then a else b;

min :: (a: uint, b: uint) -> if a < b then a else b;

saturating_sub :: (lhs: $Int, rhs: Int) -> if lhs > rhs then lhs - rhs else 0;

try_align_up_pow2 :: (x: uint, pow2: uint) -> {
    std.assert(std.num.is_power_of_2(pow2));
    a := x + (pow2 - 1);
    if a < x then return null;
    Some(a & !(pow2 - 1))
}

align_up_pow2 :: (x: uint, pow2: uint) ->
    try_align_up_pow2(x, pow2) orelse std.panic("align_up_pow2 overflowed!");

align_down_pow2 :: (x: uint, pow2: uint) -> {
    std.assert(std.num.is_power_of_2(pow2));
    x & !(pow2 - 1)
}

try_align_up :: (x: uint, alignment: uint) -> {
    std.assert(alignment != 0, "alignment must be non-zero");
    a := x + (alignment - 1);
    if a < x then return null;
    Some(a - (a % alignment))
}

align_up :: (x: uint, alignment: uint) ->
    try_align_up(x, alignment) orelse std.panic("align_up overflowed!");

/// doesn't change endianness.
from_bytes_u32 :: (bytes: [4]u8) -> bytes.&.as(*u32).*;
as_bytes_u32 :: (val: u32) -> val.&.as(*[4]u8).*;

is_ascii_lowercase :: (char: u8) -> 'a' <= char && char <= 'z';
is_ascii_uppercase :: (char: u8) -> 'A' <= char && char <= 'Z';

ASCII_CASE_MASK :: 0b0100000;
as_ascii_lowercase :: (char: u8) -> char ^ (ASCII_CASE_MASK * is_ascii_uppercase(char).as(u8));
as_ascii_uppercase :: (char: u8) -> char ^ (ASCII_CASE_MASK * is_ascii_lowercase(char).as(u8));

eq_ignore_ascii_case_u8 :: (byte1: u8, byte2: u8) ->
    byte1.as_ascii_lowercase() == byte2.as_ascii_lowercase();
