std :: #import "std";
libc :: #import "libc";
RawHashTable :: std.RawHashTable;

Hash :: u32;

hash :: (key: Str2PtrHashMap.K) -> std.hash.rapidhash_v3(key).as(Hash);

/// Does not own the stored strings
Str2PtrHashMap :: struct {
    table: RawHashTable,

    K :: []u8;
    V :: *any;
    Entry :: struct { key: K, val: V }
    ENTRY_LAYOUT :: std.mem.Layout.{ size = #sizeof(Entry), align = #alignof(Entry) };
    key_eq :: (capture: *K) -> std.closures.EqClosure.{
        fn = &(v, capture) -> std.str.eq(v.as(*Entry).*.key, capture.as(*K).*),
        capture
    };

    pub EMPTY :: Str2PtrHashMap.(.EMPTY);

    pub new :: (capacity: u32 = RawHashTable.MIN_CAPACITY, alloc := std.ctx.alloc) ->
        Str2PtrHashMap.(.new(capacity, alloc, ENTRY_LAYOUT));

    pub destroy :: (self: Str2PtrHashMap, alloc := std.ctx.alloc) ->
        self.table.destroy(alloc, ENTRY_LAYOUT.size);

    pub size :: (self: *Str2PtrHashMap) -> self.*.table.size;

    /// The number of elements in the set for which no allocations are guaranteed.
    pub capacity :: (self: *Str2PtrHashMap) -> self.*.table.&.capacity();

    pub reserve :: (self: *mut Str2PtrHashMap, additional: u32, alloc := std.ctx.alloc) -> {
        self.*.table.&mut.reserve(
            additional,
            & entry_ptr -> hash(entry_ptr.as(*Entry).*.key),
            alloc,
            ENTRY_LAYOUT,
        )
    }

    pub get :: (self: *Str2PtrHashMap, key: *K) -> ?*V {
        hash := hash(key.*);
        val_ptr := self.*.table.&.get(hash, key_eq(key), ENTRY_LAYOUT.size) orelse return null;
        val_ptr.as(*Entry).*.val.&
    }

    pub insert :: (self: *mut Str2PtrHashMap, key: K, val: V) -> ?Entry {
        self.reserve(1);
        self.insert_assume_capacity(key, val)
    }

    pub insert_assume_capacity :: (self: *mut Str2PtrHashMap, key: K, val: V) -> ?Entry {
        hash := hash(key);
        slot := self.*.table.&mut.insert_slot_assume_capacity(hash, key_eq(&key), ENTRY_LAYOUT.size);
        entry := slot.entry.as(*mut Entry);
        old_val := entry.*;
        entry.{ key, val };
        if slot.occupied Some(old_val) else null
    }

    pub contains_key :: (self: *Str2PtrHashMap, key: *K) -> bool {
        if self.size() == 0 return false; // TODO: unlikely branch
        hash := hash(key.*);
        self.*.table.&.find(hash, key_eq(key), ENTRY_LAYOUT.size) orelse return false;
        true
    }

    pub remove :: (self: *mut Str2PtrHashMap, key: *K) -> ?Entry {
        if self.size() == 0 return null; // TODO: unlikely branch

        hash := hash(key.*);
        slot := self.*.table.&mut.remove(hash, key_eq(key), ENTRY_LAYOUT.size) orelse return null;

        slot.as(*Entry).*
    }

    pub reset :: (self: *mut Str2PtrHashMap) -> self.*.table.&mut.reset(ENTRY_LAYOUT.size);

    pub reset_with_free :: (self: *mut Str2PtrHashMap, alloc := std.ctx.alloc) -> {
        for idx in 0..self.*.table.&.slots()
            alloc.free(self.*.table.&.entry(idx, ENTRY_LAYOUT.size));
        self.reset();
    }

    pub debug :: (self: *Str2PtrHashMap) -> {
        self.*.table.&.debug(
            ENTRY_LAYOUT.size,
            & v -> {
                entry := v.as(*Entry).*;
                std.fmt.format("key=\"%.*s\"; val=%p", xx entry.key.len, xx entry.key.ptr, xx entry.val)
            },
            & text -> libc.free(text.ptr),
        );
    }
}

test_map :: -> {
    fail :: () -> std.panic("test failed");

    mut map := Str2PtrHashMap.new();
    defer map.destroy();
    map := &mut map;

    std.assert(map.size() == 0);

    std.println("insert");
    map.insert("key 1", "some value".ptr);
    v2 := "another value".ptr;
    map.insert("abc", v2);
    map.insert("3", "third value".ptr);
    std.assert(map.size() == 3);
    std.assert((map.get(&"abc") orelse fail()).* == v2);

    std.println("insert duplicate keys");
    key1 := "my key";
    key2 := std.str.strdup(key1) orelse fail();
    defer std.ctx.alloc.free(key2.ptr);
    std.assert(key1.ptr != key2.ptr);

    map.insert(key1, key1.ptr);
    std.assert(map.size() == 4);
    std.assert((map.get(&key1) orelse fail()).* == key1.ptr);
    std.assert((map.get(&key2) orelse fail()).* == key1.ptr);

    map.insert(key2, key2.ptr);
    std.assert(map.size() == 4);
    std.assert((map.get(&key1) orelse fail()).* == key2.ptr);
    std.assert((map.get(&key2) orelse fail()).* == key2.ptr);


    std.println("not contains");
    std.assert(not map.contains_key(&"not in map"));

    std.println("automatic resizing");
    libc.printf("cap: %d / slots: %d\n".ptr, map.capacity(), map.*.table.&.slots());
    for idx in 0..70 {
        str := std.fmt.format("additional item %d", xx idx); // leaked
        libc.printf("## insert additional item: %s\n".ptr, str.ptr);
        map.insert(str, str.ptr);
        libc.printf("cap: %d / slots: %d\n".ptr, map.capacity(), map.*.table.&.slots());
    }

    map.debug();
}
