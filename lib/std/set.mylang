std :: #import "std";
libc :: #import "libc";
RawHashMap :: std.hashmap.RawHashMap;

Hash :: u32;

paul_larson_hash :: (mut s: *u8, seed: Hash = 0) -> {
    mut hash := seed;
    while (s.* != 0) {
        hash = hash * 101 + s.*.as(Hash);
        s = s |> std.ptr.add_bytes(1);
    }
    hash
}

//hash :: paul_larson_hash;
hash :: (s: *u8) -> std.hash.rapidhash_v3(std.str.from_cstr(s)).as(Hash);

StrHashSet :: HashSet([]u8, std.hashmap.StringKeyImpl);

HashSet :: struct($T, $Impl := std.hashmap.DefaultKeyImpl) {
    map: RawHashMap(T, void),

    Self :: HashSet(T, Impl);

    T_LAYOUT :: std.mem.Layout.{ size = #sizeof(T), align = #alignof(T) };
    hash :: Impl(T).hash;
    eq :: Impl(T).eq;

    pub EMPTY :: Self.(.EMPTY);

    pub new :: (capacity: u32 = std.hashmap.MIN_CAPACITY, alloc := std.ctx.alloc) ->
        Self.(.new(capacity, alloc));

    pub destroy :: (self: Self, alloc := std.ctx.alloc) -> self.map.destroy(alloc);

    pub size :: (self: *Self) -> self.*.map.size;

    /// The number of elements in the set for which no allocations are guaranteed.
    pub capacity :: (self: *Self) -> self.*.map.&.capacity();

    pub reserve :: (self: *mut Self, additional: u32, alloc := std.ctx.alloc) -> {
        self.*.map.&mut.reserve(additional, &hash, alloc)
    }

    pub insert :: (self: *mut Self, val: T) -> ?T {
        self.reserve(1);
        self.insert_assume_capacity(val)
    }

    pub insert_assume_capacity :: (self: *mut Self, val: T) -> ?T {
        hash := hash(val);
        eq := std.closures.EqClosure(T, T).{ fn=&eq, capture=val };
        slot := self.*.map.&mut.insert_slot_assume_capacity(hash, eq);
        old_val := slot.entry.*.key;
        slot.entry.*.key = val;
        if slot.occupied Some(old_val) else null
    }

    pub contains :: (self: *Self, val: T) -> bool  self.*.map.&.contains_key(val, &hash, &eq);

    pub remove :: (self: *mut Self, val: T) -> ?T {
        entry := self.*.map.&mut.remove(val, &hash, &eq) orelse return null;
        Some(entry.key)
    }

    pub reset :: (self: *mut Self) -> self.*.map.&mut.reset();

    pub reset_with_free :: (self: *mut Self, free: *(T) -> void) -> {
        for idx in 0..self.*.map.&.slots()
            if self.*.map.&.tag(idx).*.is_used()
                free.*(self.*.map.&.entry(idx).*.key);
        self.reset();
    }

    /*
    pub debug :: (
        self: *Self,
        format_item: *(val: T) -> []u8,
        free_text: ?*(text: []u8) -> void = null,
        c_stream := libc.stderr,
    ) -> {
        self.*.map.&.debug(& entry -> format_item.*(entry.key), free_text, c_stream);
    }
    */
}

CStrHashKeyImpl :: struct($K) {
    hash :: (s: *u8) -> std.hash.rapidhash_v3(std.str.from_cstr(s)).as(Hash);
    eq :: (l: *u8, r: *u8) -> libc.strcmp(l, r) == 0;
};

test_set :: -> {
    format_item :: (val: *u8) -> std.fmt.format("%1$p \"%1$s\"", xx val);
    free_item_text :: (text: []u8) -> libc.free(text.ptr);

    //mut set := CStrHashSet.new();
    mut set := HashSet(*u8, CStrHashKeyImpl).new();
    defer set.destroy();
    set := &mut set;

    std.assert(set.size() == 0);

    s1 := "hello world".ptr;
    s2 := libc.strdup(s1);
    defer libc.free(s2);
    std.assert(s1 != s2);

    std.println("not contains");
    std.assert(not set.contains("not in set".ptr));

    std.println("insert s1");
    set.insert(s1);
    std.assert(set.size() == 1);
    std.assert(set.contains(s1));
    std.assert(set.contains(s2));

    std.println("insert duplicate of s1");
    old := set.insert(s2);
    std.assert(old == s1);
    std.assert(set.size() == 1);

    std.println("insert more");
    set.insert("abc".ptr);
    set.insert("xyz".ptr);
    std.assert(set.size() == 3);

    std.println("remove s1");
    set.remove(s1);
    std.assert(set.size() == 2);
    std.assert(not set.contains(s2));

    //set.debug(&format_item, &free_item_text);

    std.println("automatic resizing");
    libc.printf("cap: %d / slots: %d\n".ptr, set.capacity(), set.*.map.&.slots());
    for idx in 0..100 {
        str := std.fmt.format("additional item %d", xx idx); // leaked
        libc.printf("## insert additional item: %s\n".ptr, str.ptr);
        set.insert(str.ptr);
        libc.printf("cap: %d / slots: %d\n".ptr, set.capacity(), set.*.map.&.slots());
    }

    //set.debug(&format_item, &free_item_text);
}
