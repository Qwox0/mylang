std :: #import "std";
libc :: #import "libc";
RawHashTable :: std.RawHashTable;

Hash :: u32;

paul_larson_hash :: (mut s: *u8, seed: Hash = 0) -> {
    mut hash := seed;
    while (s.* != 0) {
        hash = hash * 101 + s.*.as(Hash);
        s = s |> std.ptr.add_bytes(1);
    }
    hash
}

//hash :: paul_larson_hash;
hash :: (s: *u8) -> std.hash.rapidhash_v3(std.str.from_cstr(s)).as(Hash);

/// Does not own the stored strings
CStrHashSet :: struct {
    table: RawHashTable,

    T :: *u8;
    T_LAYOUT :: std.mem.Layout.{ size = #sizeof(T), align = #alignof(T) };
    t_eq :: (capture: T) -> RawHashTable.EqClosure.{
        fn = &(v, capture) -> libc.strcmp(v.as(*T).*, capture.as(T)) == 0,
        capture
    };

    pub EMPTY :: CStrHashSet.(.EMPTY);

    pub new :: (capacity: u32 = RawHashTable.MIN_CAPACITY, alloc := std.ctx.alloc) ->
        CStrHashSet.(.new(capacity, alloc, T_LAYOUT));

    pub destroy :: (self: CStrHashSet, alloc := std.ctx.alloc) ->
        self.table.destroy(alloc, T_LAYOUT.size);

    pub size :: (self: *CStrHashSet) -> self.*.table.size;

    /// The number of elements in the set for which no allocations are guaranteed.
    pub capacity :: (self: *CStrHashSet) -> self.*.table.&.capacity();

    pub reserve :: (self: *mut CStrHashSet, additional: u32, alloc := std.ctx.alloc) -> {
        self.*.table.&mut.reserve(
            additional,
            & entry_ptr -> hash(entry_ptr.as(*T).*),
            alloc,
            T_LAYOUT,
        )
    }

    pub insert :: (self: *mut CStrHashSet, val: T) -> ?T {
        self.reserve(1);
        self.insert_assume_capacity(val)
    }

    pub insert_assume_capacity :: (self: *mut CStrHashSet, val: T) -> ?T {
        hash := hash(val);
        slot := self.*.table.&mut.insert_slot_assume_capacity(hash, t_eq(val), T_LAYOUT.size);
        entry := slot.entry.as(*mut T);
        old_val := entry.*;
        entry.* = val;
        if slot.occupied Some(old_val) else null
    }

    pub contains :: (self: *CStrHashSet, val: T) -> bool {
        if self.size() == 0 return false; // TODO: unlikely branch
        hash := hash(val);
        self.*.table.&.find(hash, t_eq(val), T_LAYOUT.size) orelse return false;
        true
    }

    pub remove :: (self: *mut CStrHashSet, val: T) -> ?T {
        if self.size() == 0 return null; // TODO: unlikely branch

        hash := hash(val);
        slot := self.*.table.&mut.remove(hash, t_eq(val), T_LAYOUT.size) orelse return null;

        slot.as(*T).*
    }

    pub reset :: (self: *mut CStrHashSet) -> self.*.table.&mut.reset(T_LAYOUT.size);

    pub reset_with_free :: (self: *mut CStrHashSet, alloc := std.ctx.alloc) -> {
        for idx in 0..self.*.table.&.slots()
            if self.*.table.&.tag(idx).*.is_used()
                alloc.free(self.*.table.&.entry(idx, T_LAYOUT.size).as(*T).*.as(*mut u8));
        self.reset();
    }

    pub debug :: (self: *CStrHashSet) -> {
        self.*.table.&.debug(
            T_LAYOUT.size,
            & v -> std.fmt.format("%1$p \"%1$s\"", xx v.as(*T).*),
            & text -> libc.free(text.ptr),
        );
    }
}

test_set :: -> {
    mut set := CStrHashSet.new();
    defer set.destroy();
    set := &mut set;

    std.assert(set.size() == 0);

    s1 := "hello world".ptr;
    s2 := libc.strdup(s1);
    defer libc.free(s2);
    std.assert(s1 != s2);

    std.println("not contains");
    std.assert(not set.contains("not in set".ptr));

    std.println("insert s1");
    set.insert(s1);
    std.assert(set.size() == 1);
    std.assert(set.contains(s1));
    std.assert(set.contains(s2));

    std.println("insert duplicate of s1");
    old := set.insert(s2);
    std.assert(old == s1);
    std.assert(set.size() == 1);

    std.println("insert more");
    set.insert("abc".ptr);
    set.insert("xyz".ptr);
    std.assert(set.size() == 3);

    std.println("remove s1");
    set.remove(s1);
    std.assert(set.size() == 2);
    std.assert(not set.contains(s2));

    set.debug();

    std.println("automatic resizing");
    libc.printf("cap: %d / slots: %d\n".ptr, set.capacity(), set.*.table.&.slots());
    for idx in 0..100 {
        str := std.fmt.format("additional item %d", xx idx); // leaked
        libc.printf("## insert additional item: %s\n".ptr, str.ptr);
        set.insert(str.ptr);
        libc.printf("cap: %d / slots: %d\n".ptr, set.capacity(), set.*.table.&.slots());
    }

    set.debug();
}
