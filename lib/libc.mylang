setsockopt  : (fd: c_int, level: c_int, optname: c_int, optval: ?*any, optlen: socklen_t) -> c_int : #extern;
listen      : (fd: c_int, n: c_int) -> c_int : #extern;
accept      : (fd: c_int, addr: ?*mut sockaddr, addr_len: ?*mut socklen_t) -> c_int : #extern;
shutdown    : (fd: c_int, how: c_int) -> c_int : #extern;

// ===== <netinet/in.h> =====

in_addr_t :: u32;
in_addr :: in_addr_t;
in_pktinfo :: struct {
    ipi_ifindex: i32;
    ipi_spec_dst: in_addr;
    ipi_addr: in_addr;
};

in6_addr :: [16]u8;
in_port_t :: u16;

static in6addr_any: in6_addr = #extern;
static in6addr_loopback: in6_addr = #extern;

sockaddr_in :: struct {
    sin_family: sa_family_t;
    sin_port: in_port_t;
    sin_addr: in_addr;
    sin_zero: [8]u8 = .[0; 8];
};
sockaddr_in6 :: struct {
    sin6_family: sa_family_t;
    sin6_port: in_port_t;
    sin6_flowinfo: u32;
    sin6_addr: in6_addr;
    sin6_scope_id: u32;
};

ntohl : (netlong: u32) -> u32 : #extern;
ntohs : (netshort: u16) -> u16 : #extern;
htonl : (hostlong: u32) -> u32 : #extern;
htons : (hostshort: u16) -> u16 : #extern;
bindresvport  : (sockfd: i32, sock_in: ?*mut sockaddr_in ) -> i32 : #extern;
bindresvport6 : (sockfd: i32, sock_in: ?*mut sockaddr_in6) -> i32 : #extern;

// ===== <arpa/inet.h> =====

inet_addr      : (cp: ?*u8) -> in_addr_t : #extern;
inet_lnaof     : (in: in_addr) -> in_addr_t : #extern;
inet_makeaddr  : (net: in_addr_t, host: in_addr_t) -> in_addr : #extern;
inet_netof     : (in: in_addr) -> in_addr_t : #extern;
inet_network   : (cp: ?*u8) -> in_addr_t : #extern;
inet_ntoa      : (in: in_addr) -> ?*mut u8 : #extern;
inet_pton      : (af: i32, cp: ?*u8, buf: ?*mut any) -> i32 : #extern;
inet_ntop      : (af: i32, cp: ?*any, buf: ?*mut u8, len: socklen_t) -> ?*u8 : #extern;
inet_aton      : (cp: ?*u8, inp: ?*mut in_addr) -> i32 : #extern;
inet_neta      : (net: in_addr_t, buf: ?*mut u8, len: c_size_t) -> ?*mut u8 : #extern;
inet_net_ntop  : (af: i32, cp: ?*any, bits: i32, buf: ?*mut u8, len: c_size_t) -> ?*mut u8 : #extern;
inet_net_pton  : (af: i32, cp: ?*u8, buf: ?*mut any, len: c_size_t) -> i32 : #extern;
inet_nsap_addr : (cp: ?*u8, buf: ?*mut u8, len: i32) -> u32 : #extern;
inet_nsap_ntoa : (len: i32, cp: ?*u8, buf: ?*mut u8) -> ?*mut u8 : #extern;
