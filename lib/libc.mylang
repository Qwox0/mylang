pub SEEK_CUR : c_int : 1;
pub SEEK_END : c_int : 2;

fread  : (data: *mut any, size: c_size_t, count: c_size_t, stream: *FILE) -> c_size_t : #extern;
fwrite : (data: *mut any, size: c_size_t, count: c_size_t, stream: *FILE) -> c_size_t : #extern;

